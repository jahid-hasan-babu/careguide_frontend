# ==============================================================================
# CareGuide Frontend Environment Configuration
# ==============================================================================

# Port the Next.js server binds to inside and outside the container
PORT=3000
FRONTEND_PORT=3000

# Backend API server URL (rewrites /api/v1/* calls to this address)
# For local machine running outside docker: http://host.docker.internal:5000 or http://localhost:5000
# For compose service networking: http://careguide-backend:5000
BACKEND_URL=http://localhost:5000

# Next.js telemetry (1 = disabled, 0 = enabled)
NEXT_TELEMETRY_DISABLED=1
